<!--- Description -->
### Description
## {@html style_formatted_text(obj.description)}

### Example Usage
```python
import gradio as gr
from gradio.streaming import ReplyOnPause

def respond(audio, repeat):
    # What the user said, as (16000, int16 array), played back repeat times
    sample_rate, array = audio
    for _ in range(int(repeat)):
        yield (sample_rate, array), "%.1f s" % (len(array) / sample_rate)

with gr.Blocks() as demo:
    mic = gr.Audio(sources=["microphone"], streaming=True)
    repeat = gr.Number(1, label="Repeat")
    heard = gr.Textbox(label="Heard")
    mic.stream(
        ReplyOnPause(respond),
        inputs=[mic, repeat],
        outputs=[mic, heard],
        transport="webrtc",
    )

demo.launch()
```

