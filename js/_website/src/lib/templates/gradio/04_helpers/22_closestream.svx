### Example Usage
```python
import gradio as gr
from gradio.streaming import CloseStream

def flip(frame):
    brightness = float(frame.mean())
    if brightness < 10:
        return CloseStream("It is too dark, stopping the stream.")
    return frame[::-1], brightness

with gr.Blocks() as demo:
    webcam = gr.Image(sources=["webcam"], streaming=True)
    brightness = gr.Number(label="Brightness")
    webcam.stream(
        flip, inputs=[webcam], outputs=[webcam, brightness], transport="webrtc"
    )

demo.launch()
```

