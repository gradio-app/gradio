### Example Usage
```python
import numpy as np
import gradio as gr
from gradio.streaming import VideoStreamHandler

class Trails(VideoStreamHandler):
    def start_up(self):
        # Once per stream; its time limit starts when this returns
        self.average = None

    def video_receive(self, frame, strength=0.8):
        # Every frame (the newest one, if this is slower than the camera),
        # with the latest value of the slider
        frame = frame.astype(np.float32)
        if self.average is None or self.average.shape != frame.shape:
            self.average = frame
        else:
            self.average = strength * self.average + (1 - strength) * frame

    def video_emit(self):
        return None if self.average is None else self.average.astype(np.uint8)

with gr.Blocks() as demo:
    webcam = gr.Image(sources=["webcam"], streaming=True)
    strength = gr.Slider(0, 0.95, 0.8, label="Trail strength")
    webcam.stream(
        Trails, inputs=[webcam, strength], outputs=[webcam], transport="webrtc"
    )

demo.launch()
```

