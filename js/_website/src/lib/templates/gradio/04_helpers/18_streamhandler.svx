## {@html style_formatted_text(obj.description)}

### Example Usage
```python
import gradio as gr
from gradio.streaming import StreamHandler

class Echo(StreamHandler):
    def __init__(self):
        super().__init__()
        self.frames = []

    def receive(self, frame):
        # (sample_rate, int16 array) from the microphone
        self.frames.append(frame)

    def emit(self):
        # Polled for the next audio to play back; None when nothing is ready
        return self.frames.pop(0) if self.frames else None

with gr.Blocks() as demo:
    mic = gr.Audio(sources=["microphone"], streaming=True)
    mic.stream(Echo, inputs=[mic], outputs=[mic], transport="webrtc")

demo.launch()
```

